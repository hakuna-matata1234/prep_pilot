# Prep Pilot Environment Configuration
PORT=5000
VITE_API_URL=http://localhost:5000

# ==============================================================================
# SUPABASE CLOUD BACKEND & POSTGRESQL DATABASE
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. In Project Settings -> API, copy your Project URL, anon public key, and service_role key.
# 3. Paste them below:

# Frontend Supabase client credentials (Vite client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend Server Supabase credentials (Express server)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# OPTIONAL AI PROVIDER & VIDEO CREDENTIALS
# ==============================================================================
# Built-in simulator works offline out-of-the-box for hackathon judging
ANTHROPIC_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Meeting & Video Credentials (Optional - Managed WebRTC signaling built-in)
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
